{
  "name": "bricks-content-house",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write app components lib tests scripts/verify.mjs next.config.ts *.mjs *.json",
    "format:check": "prettier --check app components lib tests scripts/verify.mjs next.config.ts *.mjs *.json",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  }
}
